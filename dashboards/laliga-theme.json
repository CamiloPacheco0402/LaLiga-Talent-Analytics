{
  "name": "LaLiga Talent Analytics",
  "dataColors": ["#FF6B35", "#1F3B57", "#4A90A4", "#F2A541", "#2C3E50", "#8E9AAF", "#C44536", "#6C757D"],
  "background": "#FFFFFF",
  "foreground": "#2C3E50",
  "tableAccent": "#FF6B35",
  "good": "#2E8B57",
  "neutral": "#F2A541",
  "bad": "#C44536",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F3B57" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F3B57" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F3B57" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#2C3E50" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF1F5" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#EEF1F5" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D5DBE3" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F3B57" } }, "fontSize": 14, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "clusteredBarChart": { "*": { "labels": [{ "show": true, "color": { "solid": { "color": "#2C3E50" } } }] } },
    "barChart": { "*": { "labels": [{ "show": true, "color": { "solid": { "color": "#2C3E50" } } }] } },
    "clusteredColumnChart": { "*": { "labels": [{ "show": true, "color": { "solid": { "color": "#2C3E50" } } }] } },
    "columnChart": { "*": { "labels": [{ "show": true, "color": { "solid": { "color": "#2C3E50" } } }] } },
    "donutChart": { "*": { "labels": [{ "show": true }] } },
    "card": { "*": { "labels": [{ "color": { "solid": { "color": "#FF6B35" } }, "fontSize": 28 }], "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#2C3E50" } } }] } },
    "textbox": { "*": { "background": [{ "show": false }], "border": [{ "show": false }] } }
  }
}
